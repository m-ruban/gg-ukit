{
    "extends": "@hh.ru/stylelint-config-hh",
    "customSyntax": "postcss-less",
    "rules": {
        "hhru/less-variable-value-disallowed-list": null,
        "shorthand-property-no-redundant-values": [true, { "ignore": ["four-into-three-edge-values"] }],
        "declaration-property-value-allowed-list": {
            "font-family": ["Montserrat, sans-serif", "Montserrat", "'Open Sans', sans-serif", "'Open Sans'"]
        },
        "declaration-property-value-disallowed-list": null,
        "at-rule-allowed-list": ["media", "keyframes", "import", "font-face"]
    }
}
